# Copy this file to .env and fill in real values. .env is gitignored.

# ── Providers ────────────────────────────────────────────────────────────
# Anthropic Claude — the primary model for chain-of-title analysis.
ANTHROPIC_API_KEY=

# OpenAI — the automatic fallback when Claude is unavailable (529 overloaded,
# 5xx, rate limits, connection failures). Optional: leave blank to run on
# Claude only, in which case a Claude outage fails the run.
OPENAI_API_KEY=

# Which provider to use. Leave blank (or "auto") for Claude-with-OpenAI-fallback.
#   auto       — Claude, failing over to OpenAI per call (default)
#   anthropic  — Claude only; never call OpenAI
#   openai     — OpenAI only; never call Claude
# The --provider flag overrides this for a single run.
RUN_SHEET_PROVIDER=

# ── Model pinning ────────────────────────────────────────────────────────
# Optional. Leave blank (or "auto") to use the newest Opus model the API
# reports at startup — never older than claude-opus-5. Set an exact id, e.g.
# claude-opus-5, to pin the model for reproducible runs.
RUN_SHEET_MODEL=

# Optional. Leave blank (or "auto") for gpt-5.6-sol, OpenAI's frontier tier.
# If the key can't reach it, the newest gpt-5* model it can reach is used and
# a warning is logged. Set an exact id to pin.
RUN_SHEET_OPENAI_MODEL=

# ── OpenAI tuning (all optional) ─────────────────────────────────────────
# Reasoning effort for the analysis phases: low | medium | high | xhigh | max.
# Defaults to "high", matching the Claude path's adaptive thinking at high effort.
RUN_SHEET_OPENAI_EFFORT=

# Output-token budget per call. Reasoning models bill hidden reasoning tokens as
# output and count them against this cap, so it's larger than Claude's 16K.
# Unused headroom costs nothing. Defaults to 48000.
RUN_SHEET_OPENAI_MAX_OUTPUT=

# Set to 1 to let OpenAI retain responses server-side for 30 days. Off by
# default — run sheets are confidential client work.
RUN_SHEET_OPENAI_STORE=

# ── Failover tuning (optional) ───────────────────────────────────────────
# Seconds to skip Claude after a failover, so the remaining tracts don't each
# re-pay the retry ladder during a known outage. Defaults to 300.
RUN_SHEET_FAILOVER_COOLDOWN=
